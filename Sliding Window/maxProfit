//Two pointers
//While right < prices length
//If can make profit you calculate and see if thats max profit so far
//Otherwise since right is lower, make that left and make right ++

class Solution {
    public int maxProfit(int[] prices) {
        int left = 0;
        int right = 1;
        int max = 0;
        while (right < prices.length) {
            if (prices[left] < prices[right]) {
                int profit = prices[right] - prices[left];
                max = Math.max(max, profit);
            } else {
                left = right;
            }
            right++;
        }
        return max;
    }
}
